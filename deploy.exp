#!/usr/bin/expect -f
# ─── Wagering Wizards — VPS Deploy ────────────────────────────────────────────
# SETUP (first time only, run manually on the server):
#   1. Set up SSH key auth so you don't need a password here
#   2. Create /var/www/wagering-wizards/backend/.env with all secrets
#   3. Never commit secrets to this file or to git

set timeout 300
set host "187.124.35.84"

# Use SSH key auth — no password needed
spawn ssh -o StrictHostKeyChecking=no root@$host

expect "# " {
    send "echo '🚀 Wagering Wizards — Deploying...'\r"
}

expect "# " {
    send "echo '📦 Installing PM2 if needed...'\r"
}

expect "# " {
    send "npm install -g pm2 2>&1 | tail -2\r"
}

# Safe deploy: backup existing dir, clone, then remove backup on success
expect "# " {
    send "echo '📁 Safe deploy — backing up current app...'\r"
}

expect "# " {
    send "cp -r /var/www/wagering-wizards /var/www/wagering-wizards-backup 2>/dev/null || true\r"
}

expect "# " {
    send "rm -rf /var/www/wagering-wizards && git clone https://github.com/junioryakub5/wagering-wizards.git /var/www/wagering-wizards || { echo '❌ Clone failed — restoring backup'; mv /var/www/wagering-wizards-backup /var/www/wagering-wizards; exit 1; }\r"
}

expect "# " {
    send "rm -rf /var/www/wagering-wizards-backup\r"
}

expect "# " {
    send "echo '📦 Installing backend dependencies...'\r"
}

expect "# " {
    send "cd /var/www/wagering-wizards/backend && npm install 2>&1 | tail -3\r"
}

# NOTE: .env file should already exist on the VPS with secrets.
# Do NOT write secrets in this script. If first deploy, SSH in manually and create the file.
expect "# " {
    send "echo '🔑 Checking .env exists...'\r"
}

expect "# " {
    send "test -f /var/www/wagering-wizards/backend/.env && echo '✅ .env found' || echo '❌ .env missing — create it on the server first!'\r"
}

# Start/reload with PM2 using ecosystem.config.js
expect "# " {
    send "pm2 delete wagering-wizards-api 2>/dev/null; pm2 start /var/www/wagering-wizards/backend/ecosystem.config.js && pm2 save\r"
}

expect "# " {
    send "pm2 status\r"
}

expect "# " {
    send "curl -s http://localhost:5001/api/health\r"
}

expect "# " {
    send "exit\r"
}

expect eof

